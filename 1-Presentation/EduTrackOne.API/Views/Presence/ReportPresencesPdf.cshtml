@model EduTrackOne.API.Models.PresenceReportViewModel

@{
    Layout = null;
}

<div style="font-family:sans-serif; padding: 20px;">

 
    @if (!string.IsNullOrEmpty(Model.SchoolName))
    {
        <h1 style="text-align:center; margin-bottom:20px;">@Model.SchoolName</h1>
    }

    <h2 style="text-align:center; margin-bottom:30px;">Rapport de Présences</h2>

    <table style="width:80%; margin:0 auto 30px; border-collapse: collapse;" border="0">
        <tr>
            <td style="padding:8px; text-align:center;">
                <strong>Classe :</strong> @Model.ClasseName
            </td>
            <td style="padding:8px; text-align:center;">
                <strong>Élève :</strong> @Model.EleveName
            </td>
            <td style="padding:8px; text-align:center;">
                <strong>Matricule :</strong> @Model.NoImmatricule
            </td>
        </tr>
    </table>

    <table style="width:80%; margin:0 auto 30px; border-collapse: collapse;" border="1">
        <thead>
            <tr>
                <th style="border:1px solid #000; padding:8px; text-align:left;">Périodes présentes</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="border:1px solid #000; padding:8px; text-align:left;">
                    @if (Model.PeriodesPresentes > 0)
                    {
                        @Model.PeriodesPresentes
                    }
                    else
                    {
                        <span style="color:gray;">Aucune</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    @if (Model.Absences != null && Model.Absences.Any())
    {
        <h3 style="text-align:center; margin-top:20px; margin-bottom:10px;">Absences</h3>
        <table style="width:80%; margin:0 auto; border-collapse: collapse;" border="1">
            <colgroup>
                <col style="width:60%;" />
                <col style="width:40%;" />
            </colgroup>
            <thead>
                <tr>
                    <th style="border:1px solid #000; padding:8px; text-align:left;">Date</th>
                    <th style="border:1px solid #000; padding:8px; text-align:center;">Période</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Absences)
                {
                    <tr>
                        <td style="border:1px solid #000; padding:8px;">@a.Date.ToString("dd/MM/yyyy")</td>
                        <td style="border:1px solid #000; padding:8px; text-align:center;">@a.Periode</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="width:80%; margin:20px auto; text-align:center; color:gray;">
            Aucune absence enregistrée.
        </div>
    }

    <div style="width:80%; margin:40px auto 0; font-size:0.9em; text-align:right; color:#555;">
        Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </div>
</div>
