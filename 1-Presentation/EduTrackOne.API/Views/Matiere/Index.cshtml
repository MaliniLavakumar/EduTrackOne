@model IEnumerable<EduTrackOne.Application.Matieres.MatiereDto>

@{
    ViewData["Title"] = "Liste des matières";
    Layout = "_Layout";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nouvelle matière
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucune matière n’a été créée.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom de la matière</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mat in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@mat.Id" class="text-decoration-none">
                            @mat.Nom
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Styles {
    <style>
        /* Centrer le titre */
        h1 {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        /* Centrer le bouton "Nouvelle matière" */
        .mb-3 {
            text-align: center;
        }
        /* Table plus compacte et centrée */
        .table {
            margin: 0 auto;
            max-width: 600px;
        }
            /* Lien de la matière stylisé */
            .table a {
                color: #1d4ed8;
            }

                .table a:hover {
                    text-decoration: underline;
                    color: #1e40af;
                }
    </style>
}
