@model EduTrackOne.Application.Utilisateurs.GetAllUsers.GetAllUsersDto

@{
    ViewData["Title"] = "Détails de l’utilisateur";
}

<h1 class="text-center">Détails de @Model.Identifiant </h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-auto w-75" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })


<dl class="row">
    <dt class="col-sm-2 text-sm-end">Identifiant</dt>
    <dd class="col-sm-10">@Model.Identifiant</dd>

    <dt class="col-sm-2 text-sm-end">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2 text-sm-end">Rôle</dt>
    <dd class="col-sm-10">@Model.Role</dd>

    <dt class="col-sm-2 text-sm-end">Statut</dt>
    <dd class="col-sm-10">@Model.Statut</dd>
</dl>

<div class="mt-3">
    <a asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning ms-1"
       data-bs-toggle="tooltip" data-bs-placement="top" title="Modifier l’utilisateur">
        <i class="bi bi-pencil-fill"></i>
    </a>
    <a asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary ms-1"
       data-bs-toggle="tooltip" data-bs-placement="top" title="Changer le mot de passe">
        <i class="bi bi-key-fill"></i>
    </a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger ms-1"
       data-bs-toggle="tooltip" data-bs-placement="top" title="Supprimer l’utilisateur"
       onclick="return confirm('Confirmez-vous la suppression de cet utilisateur ?');">
        <i class="bi bi-trash-fill"></i>
    </a>
    <a asp-action="Index"
       class="btn btn-sm btn-secondary ms-4"
       data-bs-toggle="tooltip" data-bs-placement="top" title="Retour à la liste">
        ← Retour à la liste
    </a>

</div>
